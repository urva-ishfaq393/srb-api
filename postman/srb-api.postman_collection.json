          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"has free slot\", () => pm.expect(body.data.length).to.be.at.least(1));",
              "pm.collectionVariables.set(\"slotId\", body.data[0]._id);",
              "pm.test(\"paging fields\", () => { pm.expect(body.page).to.eql(1); pm.expect(body.limit).to.eql(5); });"
            ]
          }
        }
      ]
