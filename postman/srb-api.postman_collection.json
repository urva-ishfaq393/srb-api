            "api",
            "v1",
            "slots"
          ],
          "query": [
            {
              "key": "roomCode",
              "value": "ROOM-03"
            },
            {
              "key": "hasSeats",
              "value": "true"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
